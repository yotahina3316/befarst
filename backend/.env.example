# AI処理(分類・翻訳・要約)に使うAnthropic APIキー
ANTHROPIC_API_KEY=

# BE:FIRST公式サイト(WordPress REST APIのベースURL)
OFFICIAL_SITE_BASE=https://befirst.tokyo

# BE:FIRST公式YouTubeチャンネルID
YOUTUBE_CHANNEL_ID=UChNkqst-cjAoIbXb-ukn_tQ

# Web Push通知用VAPIDキー(生成方法・生成済みの値はCLAUDE.md参照)
# 秘密鍵.pemファイルへのパスを指定する。GitHub Actionsでは同名のSecretから実行時に生成する。
VAPID_PRIVATE_KEY=keys/vapid_private_key.pem
VAPID_CLAIM_EMAIL=mailto:your-email@example.com

# ロケ地/BE:Fashion候補をWeb検索・YouTube検索から拾う collect_web_extras.py 専用(任意)。
# 未設定でもcollect.py本体には影響せず、その収集だけスキップされる。取得方法はCLAUDE.md参照。
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
YOUTUBE_DATA_API_KEY=
